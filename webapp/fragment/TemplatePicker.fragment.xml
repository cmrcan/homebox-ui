<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:u="sap.ui.unified">
  <Dialog title="Şablondan alan ekle" contentWidth="30rem">
    <content>
      <VBox class="sapUiResponsiveContentPadding">
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML" class="sapUiSmallMarginBottom"/>
        <Label text="Alan şablonu" labelFor="templatePicker" class="sapUiSmallMarginBottom"/>
        <Select id="templatePicker" width="100%" selectedKey="{view&gt;/templateChoice}" items="{view&gt;/templates}" class="sapUiSmallMarginBottom">
          <core:Item key="{view&gt;id}" text="{view&gt;name}"/>
        </Select>
      </VBox>
    </content>
    <beginButton>
      <Button text="Alanları ekle" type="Emphasized" press=".onUseTemplate"/>
    </beginButton>
    <endButton>
      <Button text="Vazgeç" press=".onCancelTemplatePicker"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
