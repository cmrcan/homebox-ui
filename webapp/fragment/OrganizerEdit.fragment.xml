<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:u="sap.ui.unified">
  <Dialog title="{= ${/organizerKind} === 'locations' ? 'Konum' : 'Etiket' }" contentWidth="52rem" stretch="{/isPhone}" horizontalScrolling="false">
    <content>
      <VBox class="hb-stack sapUiResponsiveContentPadding">
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML"/>
        <VBox class="hb-field">
          <Label text="Ad" labelFor="organizerName"/>
          <Input id="organizerName" value="{/organizerForm/name}" type="Text" valueLiveUpdate="true" width="100%"/>
        </VBox>
        <VBox class="hb-field">
          <Label text="Açıklama" labelFor="organizerDescription"/>
          <TextArea id="organizerDescription" value="{/organizerForm/description}" width="100%" rows="3" valueLiveUpdate="true"/>
        </VBox>
        <VBox visible="{= ${/organizerKind} === 'locations' }" class="hb-stack">
          <VBox class="hb-field">
            <Label text="Konum türü" labelFor="locationType"/>
            <Select id="locationType" width="100%" selectedKey="{/organizerForm/entityTypeId}" items="{/locationTypes}">
              <core:Item key="{id}" text="{name}"/>
            </Select>
          </VBox>
          <VBox class="hb-field">
            <Label text="Üst konum" labelFor="organizerParent"/>
            <Select id="organizerParent" width="100%" selectedKey="{/organizerForm/parentId}" items="{/parentOptions}">
              <core:Item key="{id}" text="{name}"/>
            </Select>
          </VBox>
        </VBox>
      </VBox>
    </content>
    <beginButton>
      <Button text="Kaydet" press=".onSaveOrganizer" type="Emphasized" enabled="{= !${/saving} &amp;&amp; !${/busy} }"/>
    </beginButton>
    <endButton>
      <Button text="Pencereyi kapat" press=".onCloseDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
