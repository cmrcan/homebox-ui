<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:u="sap.ui.unified">
  <Dialog title="Ürün türü" contentWidth="52rem" stretch="{/isPhone}" horizontalScrolling="false">
    <content>
      <VBox class="hb-stack sapUiResponsiveContentPadding">
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML"/>
        <VBox class="hb-field">
          <Label text="Tür adı" labelFor="typeName"/>
          <Input id="typeName" value="{edit&gt;/name}" type="Text" valueLiveUpdate="true" width="100%"/>
        </VBox>
        <VBox class="hb-field">
          <Label text="Açıklama" labelFor="typeDescription"/>
          <TextArea id="typeDescription" value="{edit&gt;/description}" width="100%" rows="3" valueLiveUpdate="true"/>
        </VBox>
        <CheckBox text="Konum türü" selected="{edit&gt;/isLocation}"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="Türü kaydet" press=".onSave" type="Emphasized" enabled="{= !${/saving} &amp;&amp; !${/busy} }"/>
    </beginButton>
    <endButton>
      <Button text="Pencereyi kapat" press=".onCloseDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
