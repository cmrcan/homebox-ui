<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:u="sap.ui.unified">
  <Dialog title="Davet ile hesap oluştur" contentWidth="52rem" stretch="{/isPhone}" horizontalScrolling="false">
    <content>
      <VBox class="hb-stack sapUiResponsiveContentPadding">
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML"/>
        <VBox class="hb-field">
          <Label text="Ad soyad" labelFor="registerName"/>
          <Input id="registerName" value="{view&gt;/register/name}" type="Text" valueLiveUpdate="true" width="100%"/>
        </VBox>
        <VBox class="hb-field">
          <Label text="E-posta" labelFor="registerEmail"/>
          <Input id="registerEmail" value="{view&gt;/register/email}" type="Email" valueLiveUpdate="true" width="100%"/>
        </VBox>
        <VBox class="hb-field">
          <Label text="Şifre" labelFor="registerPassword"/>
          <Input id="registerPassword" value="{view&gt;/register/password}" type="Password" valueLiveUpdate="true" width="100%"/>
        </VBox>
        <VBox class="hb-field">
          <Label text="Davet kodu" labelFor="registerToken"/>
          <Input id="registerToken" value="{view&gt;/register/token}" type="Text" valueLiveUpdate="true" width="100%"/>
        </VBox>
      </VBox>
    </content>
    <beginButton>
      <Button text="Hesap oluştur" press=".onSaveRegistration" type="Emphasized" enabled="{= !${/saving} &amp;&amp; !${/busy} }"/>
    </beginButton>
    <endButton>
      <Button text="Pencereyi kapat" press=".onCloseDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
