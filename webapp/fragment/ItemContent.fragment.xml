<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:u="sap.ui.unified">
  <VBox class="sapUiResponsiveContentPadding">
    <Image src="{/selected/photoUrl}" height="14rem" width="100%" densityAware="false" alt="{/selected/name}" decorative="false" visible="{= !!${/selected/photoUrl} }" class="sapUiSmallMarginBottom"/>
    <Text text="{/selected/description}" class="sapUiSmallMarginBottom"/>
    <f:SimpleForm editable="false" layout="ResponsiveGridLayout" class="sapUiSmallMarginBottom">
      <f:content>
        <Label text="Konum"/>
        <Text text="{parts:['/selected/parent','/selected/location'],formatter:'.formatter.location'}"/>
        <Label text="Değer"/>
        <Text text="{parts:['/selected/purchasePrice','/currency'],formatter:'.formatter.money'}"/>
        <Label text="Adet"/>
        <Text text="{/selected/quantity}"/>
        <Label text="Marka"/>
        <Text text="{/selected/manufacturer}"/>
        <Label text="Model"/>
        <Text text="{/selected/modelNumber}"/>
        <Label text="Seri numarası"/>
        <Text text="{/selected/serialNumber}"/>
        <Label text="Satın alma tarihi"/>
        <Text text="{path:'/selected/displayPurchaseDate',formatter:'.formatter.date'}"/>
        <Label text="Garanti bitişi"/>
        <Text text="{path:'/selected/warrantyExpires',formatter:'.formatter.date'}"/>
        <Label text="Etiketler"/>
        <Text text="{path:'/selected/tags',formatter:'.formatter.tags'}"/>
      </f:content>
    </f:SimpleForm>
    <Text text="{/selected/notes}" class="sapUiSmallMarginBottom"/>
    <VBox items="{/selected/fields}" class="sapUiSmallMarginBottom">
      <HBox class="sapUiSmallMarginBottom">
        <Label text="{name}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
        <Text text="{parts:['type','textValue','numberValue','booleanValue','timeValue'],formatter:'.formatter.fieldValue'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
      </HBox>
    </VBox>
    <Panel headerText="Dosyalar" class="sapUiSmallMarginBottom">
      <VBox>
        <VBox class="sapUiSmallMarginBottom">
          <Label text="Dosya türü" labelFor="fileType"/>
          <Select id="fileType" width="100%" selectedKey="{/uploadType}">
            <core:Item key="photo" text="Fotoğraf"/>
            <core:Item key="receipt" text="Fatura"/>
            <core:Item key="warranty" text="Garanti"/>
            <core:Item key="manual" text="Kılavuz"/>
            <core:Item key="attachment" text="Diğer"/>
          </Select>
        </VBox>
        <u:FileUploader buttonOnly="true" buttonText="Dosya yükle" sameFilenameAllowed="true" change=".onUpload" class="sapUiSmallMarginBottom"/>
        <VBox items="{/selected/attachments}" class="sapUiSmallMarginBottom">
          <Link text="{title}" href="{url}" target="_blank"/>
        </VBox>
      </VBox>
    </Panel>
    <Panel headerText="Bakım" class="sapUiSmallMarginBottom">
      <VBox>
        <Button text="Bakım kayıtlarını göster" press=".onLoadItemMaintenance" visible="{= !${view&gt;/maintenanceLoaded} }" class="sapUiSmallMarginBottom"/>
        <VBox visible="{view&gt;/maintenanceLoaded}" class="sapUiSmallMarginBottom">
          <VBox items="{view&gt;/itemMaintenance}" class="sapUiSmallMarginBottom">
            <Panel headerText="{view&gt;name}" class="sapUiSmallMarginBottom">
              <VBox>
                <Text text="{view&gt;description}" class="sapUiSmallMarginBottom"/>
                <Text text="{path:'view&gt;scheduledDate',formatter:'.formatter.date'}" class="sapUiSmallMarginBottom"/>
                <ObjectNumber number="{parts:['view&gt;cost','/currency'],formatter:'.formatter.money'}" class="sapUiSmallMarginBottom"/>
                <HBox class="sapUiSmallMarginBottom">
                  <Button text="Tamamlandı" press=".onCompleteMaintenance" visible="{= !${view&gt;completedDate} || ${view&gt;completedDate}.indexOf('0001') === 0 }" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                  <Button text="Sil" press=".onDeleteMaintenance" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                </HBox>
              </VBox>
            </Panel>
          </VBox>
          <Panel headerText="Bakım ekle" class="sapUiSmallMarginBottom">
            <VBox>
              <VBox class="sapUiSmallMarginBottom">
                <Label text="Bakım adı" labelFor="maintenanceName"/>
                <Input id="maintenanceName" value="{view&gt;/maintenanceForm/name}" type="Text" valueLiveUpdate="true" width="100%"/>
              </VBox>
              <VBox class="sapUiSmallMarginBottom">
                <Label text="Açıklama" labelFor="maintenanceDescription"/>
                <TextArea id="maintenanceDescription" value="{view&gt;/maintenanceForm/description}" width="100%" rows="3" valueLiveUpdate="true"/>
              </VBox>
              <VBox class="sapUiSmallMarginBottom">
                <Label text="Maliyet" labelFor="maintenanceCost"/>
                <Input id="maintenanceCost" value="{view&gt;/maintenanceForm/cost}" type="Number" valueLiveUpdate="true" width="100%"/>
              </VBox>
              <VBox class="sapUiSmallMarginBottom">
                <Label text="Planlanan tarih" labelFor="maintenanceDate"/>
                <DatePicker id="maintenanceDate" value="{view&gt;/maintenanceForm/scheduledDate}" valueFormat="yyyy-MM-dd" displayFormat="medium" width="100%"/>
              </VBox>
              <Button text="Bakımı kaydet" press=".onAddMaintenance" type="Emphasized" class="sapUiSmallMarginBottom"/>
            </VBox>
          </Panel>
        </VBox>
      </VBox>
    </Panel>
  </VBox>
</core:FragmentDefinition>
