<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:u="sap.ui.unified">
  <Dialog title="Alan şablonu" contentWidth="52rem" stretch="{/isPhone}" horizontalScrolling="false">
    <content>
      <VBox class="hb-stack sapUiResponsiveContentPadding">
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML"/>
        <VBox class="hb-field">
          <Label text="Şablon adı" labelFor="templateName"/>
          <Input id="templateName" value="{edit&gt;/name}" type="Text" valueLiveUpdate="true" width="100%"/>
        </VBox>
        <VBox class="hb-field">
          <Label text="Açıklama" labelFor="templateDescription"/>
          <TextArea id="templateDescription" value="{edit&gt;/description}" width="100%" rows="3" valueLiveUpdate="true"/>
        </VBox>
        <VBox class="hb-field">
          <Label text="Varsayılan ürün adı" labelFor="defaultName"/>
          <Input id="defaultName" value="{edit&gt;/defaultName}" type="Text" valueLiveUpdate="true" width="100%"/>
        </VBox>
        <VBox class="hb-field">
          <Label text="Varsayılan marka" labelFor="defaultManufacturer"/>
          <Input id="defaultManufacturer" value="{edit&gt;/defaultManufacturer}" type="Text" valueLiveUpdate="true" width="100%"/>
        </VBox>
        <VBox class="hb-field">
          <Label text="Varsayılan model" labelFor="defaultModel"/>
          <Input id="defaultModel" value="{edit&gt;/defaultModelNumber}" type="Text" valueLiveUpdate="true" width="100%"/>
        </VBox>
        <VBox class="hb-field">
          <Label text="Varsayılan adet" labelFor="defaultQuantity"/>
          <Input id="defaultQuantity" value="{edit&gt;/defaultQuantity}" type="Number" valueLiveUpdate="true" width="100%"/>
        </VBox>
        <core:Fragment fragmentName="homebox.fragment.FieldsEditor" type="XML"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="Şablonu kaydet" press=".onSave" type="Emphasized" enabled="{= !${/saving} &amp;&amp; !${/busy} }"/>
    </beginButton>
    <endButton>
      <Button text="Pencereyi kapat" press=".onCloseDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
