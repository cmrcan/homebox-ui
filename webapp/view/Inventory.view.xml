<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="homebox.controller.Inventory">
  <Page showHeader="false" class="hb-content-page">
    <content>
      <VBox width="100%" class="hb-page hb-stack">
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML"/>
        <Text text="{/groupName}" class="hb-muted"/>
        <FlexBox renderType="Bare" wrap="Wrap" justifyContent="SpaceBetween" alignItems="Center" class="hb-row">
          <Title text="Envanterim" level="H1" titleStyle="H2" wrapping="true"/>
          <Button text="Ürün ekle" type="Emphasized" icon="sap-icon://add" press=".onAddItem" enabled="{= !${/saving} &amp;&amp; !${/busy} }"/>
        </FlexBox>
        <Text text="Eşyalarını bul, bilgilerini güncelle, düzenini koru."/>
        <core:Fragment fragmentName="homebox.fragment.Inventory" type="XML"/>
      </VBox>
    </content>
  </Page>
</mvc:View>
