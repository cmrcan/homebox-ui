<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="homebox.controller.Login" displayBlock="true" height="100%">
  <VBox width="100%" height="100%" alignItems="Center" justifyContent="Center" class="hb-login">
    <VBox width="100%" class="hb-login-card hb-stack">
      <Image src="{= ${/dark} ? 'assets/homebox-logo-dark.svg' : 'assets/homebox-logo.svg' }" width="16rem" height="2.74rem" decorative="false" densityAware="false" alt="Homebox" class="hb-brand-logo"/>
      <Title text="Evine hoş geldin." level="H1" titleStyle="H2" wrapping="true"/>
      <Text text="Homebox hesabınla giriş yap, eşyaların bir arada olsun."/>
      <core:Fragment fragmentName="homebox.fragment.Error" type="XML"/>
      <VBox class="hb-field">
        <Label text="E-posta" labelFor="email"/>
        <Input id="email" value="{view&gt;/email}" type="Email" valueLiveUpdate="true" submit=".onLogin"/>
      </VBox>
      <VBox class="hb-field">
        <Label text="Şifre" labelFor="password"/>
        <Input id="password" value="{view&gt;/password}" type="{= ${view&gt;/showPassword} ? 'Text' : 'Password' }" valueLiveUpdate="true" submit=".onLogin"/>
      </VBox>
      <Button text="{= ${view&gt;/showPassword} ? 'Şifreyi gizle' : 'Şifreyi göster' }" icon="sap-icon://show" press=".onTogglePassword"/>
      <Button text="Giriş yap" type="Emphasized" icon="sap-icon://log" width="100%" press=".onLogin" enabled="{= !${/saving} &amp;&amp; !${/busy} }"/>
      <Button text="Davet ile hesap oluştur" press=".onRegister"/>
      <Text text="Homebox UI v0.5.0 · OpenUI5 MVC" class="hb-muted"/>
    </VBox>
  </VBox>
</mvc:View>
