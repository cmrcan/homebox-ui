<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="homebox.controller.Login" displayBlock="true" height="100%">
  <VBox width="100%" height="100%" alignItems="Center" justifyContent="Start" class="sapUiResponsiveContentPadding">
    <l:Grid xmlns:l="sap.ui.layout" defaultSpan="XL4 L6 M8 S12" defaultIndent="XL4 L3 M2 S0" width="100%">
      <VBox width="100%" class="sapUiSmallMarginTop">
        <Image src="{= ${/dark} ? 'assets/homebox-logo-dark.svg' : 'assets/homebox-logo.svg' }" width="16rem" height="2.74rem" decorative="false" densityAware="false" alt="Homebox" class="sapUiSmallMarginBottom"/>
        <Title text="Evine hoş geldin." level="H1" titleStyle="H2" wrapping="true" class="sapUiSmallMarginBottom"/>
        <Text text="Homebox hesabınla giriş yap, eşyaların bir arada olsun." class="sapUiSmallMarginBottom"/>
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML" class="sapUiSmallMarginBottom"/>
        <VBox class="sapUiSmallMarginBottom">
          <Label text="E-posta" labelFor="email"/>
          <Input id="email" value="{view&gt;/email}" type="Email" valueLiveUpdate="true" submit=".onLogin"/>
        </VBox>
        <VBox class="sapUiSmallMarginBottom">
          <Label text="Şifre" labelFor="password"/>
          <Input id="password" value="{view&gt;/password}" type="{= ${view&gt;/showPassword} ? 'Text' : 'Password' }" valueLiveUpdate="true" submit=".onLogin"/>
        </VBox>
        <Button text="{= ${view&gt;/showPassword} ? 'Şifreyi gizle' : 'Şifreyi göster' }" icon="sap-icon://show" press=".onTogglePassword" class="sapUiSmallMarginBottom"/>
        <Button text="Giriş yap" type="Emphasized" icon="sap-icon://log" width="100%" press=".onLogin" enabled="{= !${/saving} &amp;&amp; !${/busy} }" class="sapUiSmallMarginBottom"/>
        <Button text="Davet ile hesap oluştur" press=".onRegister" class="sapUiSmallMarginBottom"/>
        <Text text="Homebox UI v0.5.2 · OpenUI5 MVC" class="sapUiSmallMarginBottom"/>
      </VBox>
    </l:Grid>
  </VBox>
</mvc:View>
