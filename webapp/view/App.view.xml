<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:tnt="sap.tnt" xmlns:core="sap.ui.core" controllerName="homebox.controller.App" displayBlock="true" height="100%">
  <VBox fitContainer="true" renderType="Bare">
    <mvc:XMLView viewName="homebox.view.Login" visible="{= !${/user} }" height="100%"/>
    <tnt:ToolPage id="toolPage" visible="{= !!${/user} }" sideExpanded="{/sideExpanded}">
      <tnt:layoutData>
        <FlexItemData growFactor="1" baseSize="0%" shrinkFactor="1"/>
      </tnt:layoutData>
      <tnt:header>
        <tnt:ToolHeader id="toolHeader">
          <Button id="menuButton" icon="sap-icon://menu2" type="Transparent" tooltip="Menüyü aç" press=".onToggleNavigation">
            <layoutData>
              <OverflowToolbarLayoutData priority="NeverOverflow"/>
            </layoutData>
          </Button>
          <Image src="{= ${/dark} ? 'assets/homebox-logo-dark.svg' : 'assets/homebox-logo.svg' }" width="9rem" height="1.55rem" decorative="false" alt="Homebox" densityAware="false">
            <layoutData>
              <OverflowToolbarLayoutData priority="NeverOverflow"/>
            </layoutData>
          </Image>
          <tnt:ToolHeaderUtilitySeparator/>
          <Text text="{/title}" visible="{= !${/isPhone} }"/>
          <ToolbarSpacer/>
          <SearchField id="globalSearch" width="20rem" placeholder="Envanterde hızlı arama" tooltip="Hızlı arama" search=".onGlobalSearch" visible="{= !${/isPhone} }"/>
          <Select enabled="{= !${/saving} &amp;&amp; !${/busy} }" width="11rem" tooltip="Koleksiyon" selectedKey="{/tenant}" items="{/groups}" change=".onGroupChange">
            <core:Item key="{id}" text="{name}"/>
          </Select>
          <Button icon="sap-icon://refresh" type="Transparent" tooltip="Verileri yenile" press=".onRefresh" enabled="{= !${/busy} &amp;&amp; !${/saving} }"/>
          <Button id="themeButton" icon="{= ${/dark} ? 'sap-icon://light-mode' : 'sap-icon://dark-mode' }" type="Transparent" tooltip="{= ${/dark} ? 'Açık görünüm' : 'Koyu görünüm' }" press=".onToggleTheme"/>
          <Avatar displaySize="XS" initials="{path:'/user/name',formatter:'.formatter.initials'}" tooltip="{/user/name}" press=".onProfile"/>
        </tnt:ToolHeader>
      </tnt:header>
      <tnt:sideContent>
        <tnt:SideNavigation id="sideNavigation" ariaLabel="Ana menü" selectedKey="{/tab}" itemSelect=".onNavigationSelect">
          <tnt:item>
            <tnt:NavigationList>
              <tnt:NavigationListItem text="Genel bakış" key="overview" icon="sap-icon://home"/>
              <tnt:NavigationListItem text="Envanter" key="inventoryGroup" icon="sap-icon://product" expanded="true">
                <tnt:NavigationListItem text="Envanterim" key="inventory"/>
                <tnt:NavigationListItem text="Konumlar" key="locations"/>
                <tnt:NavigationListItem text="Etiketler" key="tags"/>
              </tnt:NavigationListItem>
              <tnt:NavigationListItem text="Yönetim" key="managementGroup" icon="sap-icon://action-settings" expanded="true">
                <tnt:NavigationListItem text="Ürün türleri" key="types"/>
                <tnt:NavigationListItem text="Alan şablonları" key="templates"/>
                <tnt:NavigationListItem text="Bakım" key="maintenance"/>
              </tnt:NavigationListItem>
            </tnt:NavigationList>
          </tnt:item>
          <tnt:fixedItem>
            <tnt:NavigationList>
              <tnt:NavigationListItem text="Ürün ekle" key="create" icon="sap-icon://add"/>
              <tnt:NavigationListItem text="Kullanıcılar" key="users" icon="sap-icon://group"/>
              <tnt:NavigationListItem text="Araçlar" key="tools" icon="sap-icon://wrench"/>
              <tnt:NavigationListItem text="Çıkış yap" key="logout" icon="sap-icon://log"/>
            </tnt:NavigationList>
          </tnt:fixedItem>
        </tnt:SideNavigation>
      </tnt:sideContent>
      <tnt:mainContents>
        <NavContainer id="pages" width="100%" height="100%"/>
      </tnt:mainContents>
    </tnt:ToolPage>
  </VBox>
</mvc:View>
