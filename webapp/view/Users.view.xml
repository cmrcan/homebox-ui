<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:u="sap.ui.unified" controllerName="homebox.controller.Users" height="100%">
  <Page showHeader="false" class="sapUiContentPadding">
    <content>
      <VBox width="100%">
        <core:Fragment fragmentName="homebox.fragment.Breadcrumbs" type="XML"/>
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML" class="sapUiSmallMarginBottom"/>
        <Text text="{/groupName}" class="sapUiSmallMarginBottom"/>
        <Title text="Kullanıcılar" level="H1" titleStyle="H2" class="sapUiSmallMarginBottom"/>
        <Panel headerText="Profil" class="sapUiSmallMarginBottom">
          <VBox>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="Ad soyad" labelFor="profileName"/>
              <Input id="profileName" value="{view&gt;/profile/name}" type="Text" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="E-posta" labelFor="profileEmail"/>
              <Input id="profileEmail" value="{view&gt;/profile/email}" type="Email" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <Button text="Profili kaydet" type="Emphasized" press=".onSaveProfile" class="sapUiSmallMarginBottom"/>
          </VBox>
        </Panel>
        <Panel headerText="Şifre değiştir" class="sapUiSmallMarginBottom">
          <VBox>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="Mevcut şifre" labelFor="currentPassword"/>
              <Input id="currentPassword" value="{view&gt;/password/current}" type="Password" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="Yeni şifre" labelFor="nextPassword"/>
              <Input id="nextPassword" value="{view&gt;/password/next}" type="Password" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="Yeni şifre tekrar" labelFor="repeatPassword"/>
              <Input id="repeatPassword" value="{view&gt;/password/again}" type="Password" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <Button text="Şifreyi değiştir" press=".onChangePassword" class="sapUiSmallMarginBottom"/>
          </VBox>
        </Panel>
        <Panel headerText="Koleksiyon" class="sapUiSmallMarginBottom">
          <VBox>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="Koleksiyon adı" labelFor="groupName"/>
              <Input id="groupName" value="{view&gt;/group/name}" type="Text" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="Para birimi" labelFor="currency"/>
              <Input id="currency" value="{view&gt;/group/currency}" type="Text" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <Button text="Koleksiyonu kaydet" press=".onSaveGroup" class="sapUiSmallMarginBottom"/>
          </VBox>
        </Panel>
        <Panel headerText="Davet oluştur" class="sapUiSmallMarginBottom">
          <VBox>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="Kullanım sayısı" labelFor="inviteUses"/>
              <Input id="inviteUses" value="{view&gt;/invite/uses}" type="Number" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="Geçerlilik (gün)" labelFor="inviteDays"/>
              <Input id="inviteDays" value="{view&gt;/invite/days}" type="Number" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <Button text="Davet oluştur" press=".onInvite" class="sapUiSmallMarginBottom"/>
            <Text text="{view&gt;/token}" class="sapUiSmallMarginBottom"/>
            <Button text="Davet kodunu kopyala" press=".onCopyToken" visible="{= !!${view&gt;/token} }" class="sapUiSmallMarginBottom"/>
          </VBox>
        </Panel>
        <Panel headerText="Koleksiyon üyeleri" class="sapUiSmallMarginBottom">
          <VBox>
            <Text text="{view&gt;/membersNote}" class="sapUiSmallMarginBottom"/>
            <VBox items="{view&gt;/members}" class="sapUiSmallMarginBottom">
              <HBox class="sapUiSmallMarginBottom">
                <Text text="{view&gt;name}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                <Text text="{view&gt;email}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                <ObjectStatus text="Sahip" visible="{view&gt;isOwner}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                <Button text="Üyeyi çıkar" press=".onRemoveMember" visible="{= !${view&gt;isOwner} }" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
              </HBox>
            </VBox>
          </VBox>
        </Panel>
        <Panel headerText="Hesabı sil" class="sapUiSmallMarginBottom">
          <VBox>
            <Text text="Hesabın silinmesi geri alınamaz. Devam etmek için SİL yazın." class="sapUiSmallMarginBottom"/>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="Onay metni" labelFor="deleteText"/>
              <Input id="deleteText" value="{view&gt;/deleteText}" type="Text" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <Button text="Hesabı sil" type="Reject" press=".onDeleteAccount" class="sapUiSmallMarginBottom"/>
          </VBox>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
