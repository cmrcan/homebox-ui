<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:uxap="sap.uxap" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" controllerName="homebox.controller.Organizer" height="100%">
  <Page id="organizerPage" showHeader="false" enableScrolling="false" busy="{view&gt;/loading}" busyIndicatorDelay="0">
    <content>
      <uxap:ObjectPageLayout id="objectPage" height="100%" subSectionLayout="TitleOnTop" upperCaseAnchorBar="false" showAnchorBar="true" showAnchorBarPopover="false" enableLazyLoading="false" showFooter="{view&gt;/editing}" headerContentPinnable="true">
        <uxap:headerTitle>
          <uxap:ObjectPageDynamicHeaderTitle>
            <uxap:breadcrumbs>
              <Breadcrumbs currentLocationText="{view&gt;/pageTitle}" links="{view&gt;/crumbs}">
                <Link text="{view&gt;text}" press=".onCrumb"/>
              </Breadcrumbs>
            </uxap:breadcrumbs>
            <uxap:heading>
              <HBox alignItems="Center" width="100%">
                <Button icon="sap-icon://nav-back" tooltip="Geri" press=".onBack" type="Transparent" class="sapUiTinyMarginEnd">
                  <layoutData>
                    <FlexItemData shrinkFactor="0"/>
                  </layoutData>
                </Button>
                <Title text="{view&gt;/pageTitle}" level="H1" wrapping="true">
                  <layoutData>
                    <FlexItemData shrinkFactor="1" minWidth="0"/>
                  </layoutData>
                </Title>
              </HBox>
            </uxap:heading>
            <uxap:expandedContent>
              <Text text="{= ${view&gt;/editing} ? 'Düzenleme · Değişiklikleri alttaki Kaydet ile onayla' : ${/organizerKind} === 'locations' ? 'Konum' : 'Etiket' }"/>
            </uxap:expandedContent>
            <uxap:actions>
              <Button text="Düzenle" icon="sap-icon://edit" press=".onEdit" visible="{= ${view&gt;/ready} &amp;&amp; !${view&gt;/editing} }" type="Transparent">
                <layoutData>
                  <OverflowToolbarLayoutData priority="NeverOverflow"/>
                </layoutData>
              </Button>
              <Button text="Ürünleri gör" icon="sap-icon://product" press=".onViewItems" visible="{= ${view&gt;/ready} &amp;&amp; !${view&gt;/editing} }" type="Transparent">
                <layoutData>
                  <OverflowToolbarLayoutData priority="AlwaysOverflow"/>
                </layoutData>
              </Button>
            </uxap:actions>
          </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:headerContent>
          <l:Grid width="100%" defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" visible="{= ${view&gt;/ready} &amp;&amp; !${view&gt;/editing} }">
            <Avatar src="{= ${/organizerKind} === 'locations' ? 'sap-icon://home' : 'sap-icon://tag' }" displaySize="L" displayShape="Square"/>
            <VBox>
              <Label text="{= ${/organizerKind} === 'locations' ? 'Üst konum' : 'Üst etiket' }"/>
              <Link text="{= ${/organizer/parent/name} || (${/organizerKind} === 'locations' ? 'Ana konum' : 'Üst etiket yok') }" press=".onParent" enabled="{= !!${/organizer/parent/id} }"/>
            </VBox>
            <VBox>
              <Label text="Ürün sayısı"/>
              <ObjectNumber number="{= ${/organizer/itemCount} || 0 }"/>
            </VBox>
            <VBox>
              <Label text="Tür"/>
              <Text text="{= ${/organizer/entityType/name} || (${/organizerKind} === 'locations' ? 'Konum' : 'Etiket') }"/>
            </VBox>
          </l:Grid>
        </uxap:headerContent>
        <uxap:sections>
          <uxap:ObjectPageSection id="generalSection" title="Genel Bilgiler" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection title="{= ${/organizerKind} === 'locations' ? 'Konum Bilgileri' : 'Etiket Bilgileri' }" titleUppercase="false">
                <uxap:blocks>
                  <VBox width="100%">
                    <core:Fragment fragmentName="homebox.fragment.Error" type="XML"/>
                    <VBox visible="{= ${view&gt;/ready} &amp;&amp; !${view&gt;/editing} }">
                      <f:SimpleForm editable="false" layout="ResponsiveGridLayout">
                        <Label text="Ad"/>
                        <Text text="{/organizer/name}"/>
                        <Label text="Açıklama"/>
                        <Text text="{/organizer/description}"/>
                      </f:SimpleForm>
                    </VBox>
                    <VBox visible="{= ${view&gt;/ready} &amp;&amp; ${view&gt;/editing} }">
                      <core:Fragment fragmentName="homebox.fragment.OrganizerForm" type="XML"/>
                    </VBox>
                  </VBox>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection id="hierarchySection" title="Hiyerarşi" titleUppercase="false" visible="{= ${view&gt;/ready} &amp;&amp; !${view&gt;/editing} &amp;&amp; ${/organizerKind} === 'locations' }">
            <uxap:subSections>
              <uxap:ObjectPageSubSection title="Üst Konum ve Tür" titleUppercase="false">
                <uxap:blocks>
                  <VBox width="100%">
                    <f:SimpleForm editable="false" layout="ResponsiveGridLayout">
                      <Label text="{= ${/organizerKind} === 'locations' ? 'Üst konum' : 'Üst etiket' }"/>
                      <Link text="{= ${/organizer/parent/name} || (${/organizerKind} === 'locations' ? 'Ana konum' : 'Üst etiket yok') }" press=".onParent" enabled="{= !!${/organizer/parent/id} }"/>
                      <Label text="Tür"/>
                      <Text text="{/organizer/entityType/name}"/>
                    </f:SimpleForm>
                  </VBox>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
        </uxap:sections>
        <uxap:footer>
          <OverflowToolbar>
            <ToolbarSpacer/>
            <Button text="Vazgeç" press=".onCancelEdit" enabled="{= !${/saving} }">
              <layoutData>
                <OverflowToolbarLayoutData priority="NeverOverflow"/>
              </layoutData>
            </Button>
            <Button text="Kaydet" icon="sap-icon://save" type="Emphasized" press=".onSave" enabled="{= ${view&gt;/ready} &amp;&amp; !${/saving} &amp;&amp; !${/busy} }">
              <layoutData>
                <OverflowToolbarLayoutData priority="NeverOverflow"/>
              </layoutData>
            </Button>
          </OverflowToolbar>
        </uxap:footer>
      </uxap:ObjectPageLayout>
    </content>
  </Page>
</mvc:View>
