<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:u="sap.ui.unified" controllerName="homebox.controller.Tools" height="100%">
  <Page showHeader="false" class="sapUiContentPadding">
    <content>
      <VBox width="100%">
        <core:Fragment fragmentName="homebox.fragment.Breadcrumbs" type="XML"/>
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML" class="sapUiSmallMarginBottom"/>
        <Text text="{/groupName}" class="sapUiSmallMarginBottom"/>
        <Title text="Araçlar" level="H1" titleStyle="H2" class="sapUiSmallMarginBottom"/>
        <Panel headerText="Envanteri aktar" class="sapUiSmallMarginBottom">
          <VBox>
            <Button text="CSV dışa aktar" icon="sap-icon://download" press=".onExport" class="sapUiSmallMarginBottom"/>
            <u:FileUploader buttonOnly="true" buttonText="CSV dosyası seç" fileType="csv" change=".onPickFile" class="sapUiSmallMarginBottom"/>
            <Text text="{view&gt;/fileName}" class="sapUiSmallMarginBottom"/>
            <Button text="CSV içe aktar" icon="sap-icon://upload" press=".onImport" class="sapUiSmallMarginBottom"/>
          </VBox>
        </Panel>
        <Panel headerText="Bildirimler" class="sapUiSmallMarginBottom">
          <VBox>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="Bildirim adı" labelFor="notifierName"/>
              <Input id="notifierName" value="{view&gt;/notifier/name}" type="Text" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <VBox class="sapUiSmallMarginBottom">
              <Label text="Bildirim URL" labelFor="notifierUrl"/>
              <Input id="notifierUrl" value="{view&gt;/notifier/url}" type="Text" valueLiveUpdate="true" width="100%"/>
            </VBox>
            <HBox class="sapUiSmallMarginBottom">
              <Button text="Bildirim ekle" press=".onAddNotifier" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
              <Button text="Test bildirimi gönder" press=".onTestNotifier" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
            </HBox>
            <Text text="{view&gt;/notifierNote}" class="sapUiSmallMarginBottom"/>
            <VBox items="{view&gt;/notifiers}" class="sapUiSmallMarginBottom">
              <HBox class="sapUiSmallMarginBottom">
                <Text text="{view&gt;name}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                <CheckBox text="Etkin" selected="{view&gt;isActive}" select=".onToggleNotifier" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                <Button text="Sil" press=".onDeleteNotifier" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
              </HBox>
            </VBox>
          </VBox>
        </Panel>
        <Panel headerText="Bakım araçları" class="sapUiSmallMarginBottom">
          <VBox items="{view&gt;/actions}">
            <Button text="{view&gt;name}" icon="sap-icon://wrench" press=".onRunAction" class="sapUiSmallMarginBottom"/>
          </VBox>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
