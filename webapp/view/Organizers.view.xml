<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="homebox.controller.Organizers" height="100%">
  <Page showHeader="false" class="sapUiContentPadding">
    <content>
      <VBox width="100%">
        <core:Fragment fragmentName="homebox.fragment.Breadcrumbs" type="XML"/>
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML" class="sapUiSmallMarginBottom"/>
        <Text text="{/groupName}" class="sapUiSmallMarginBottom"/>
        <FlexBox renderType="Bare" wrap="Wrap" justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
          <Title text="{/title}" level="H1" titleStyle="H2" wrapping="true" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
          <Button text="{= ${/tab} === 'locations' ? 'Konum ekle' : 'Etiket ekle' }" icon="sap-icon://add" type="Emphasized" press=".onOpenOrganizer" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
        </FlexBox>
        <Table id="organizerTable" items="{view&gt;/organizers}" autoPopinMode="true" contextualWidth="Auto" fixedLayout="true" growing="true" growingThreshold="25" noDataText="Henüz kayıt yok.">
          <columns>
            <Column width="12rem" importance="High">
              <Text text="Ad"/>
            </Column>
            <Column width="16rem" importance="Low">
              <Text text="Açıklama"/>
            </Column>
            <Column width="10rem" importance="Low">
              <Text text="Üst kayıt"/>
            </Column>
            <Column width="8rem" importance="Low">
              <Text text="Tür"/>
            </Column>
            <Column width="6rem" importance="Medium">
              <Text text="Ürün sayısı"/>
            </Column>
            <Column width="14rem" importance="High">
              <Text text="İşlemler"/>
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press=".onEditOrganizer" vAlign="Middle">
              <cells>
                <ObjectIdentifier title="{view&gt;name}"/>
                <Text text="{view&gt;description}"/>
                <Text text="{view&gt;parent/name}"/>
                <Text text="{view&gt;entityType/name}"/>
                <ObjectNumber number="{= ${view&gt;itemCount} || 0 }"/>
                <HBox wrap="Wrap">
                  <Button text="Ürünleri gör" icon="sap-icon://product" press=".onViewOrganizer" class="sapUiTinyMarginEnd"/>
                  <Button text="Detayı aç" icon="sap-icon://inspect" press=".onEditOrganizer"/>
                </HBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
