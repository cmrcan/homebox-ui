<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="homebox.controller.Organizers">
  <Page showHeader="false" class="hb-content-page">
    <content>
      <VBox width="100%" class="hb-page hb-stack">
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML"/>
        <Text text="{/groupName}" class="hb-muted"/>
        <FlexBox renderType="Bare" wrap="Wrap" justifyContent="SpaceBetween" alignItems="Center" class="hb-row">
          <Title text="{/title}" level="H1" titleStyle="H2" wrapping="true"/>
          <Button text="{= ${/tab} === 'locations' ? 'Konum ekle' : 'Etiket ekle' }" icon="sap-icon://add" type="Emphasized" press=".onOpenOrganizer"/>
        </FlexBox>
        <VBox items="{view&gt;/organizers}" class="hb-stack">
          <Panel headerText="{view&gt;name}">
            <VBox class="hb-stack">
              <Text text="{view&gt;description}"/>
              <Text text="{= (${view&gt;itemCount} || 0) + ' ürün' }"/>
              <HBox class="hb-row">
                <Button text="Ürünleri gör" icon="sap-icon://product" press=".onViewOrganizer"/>
                <Button text="Düzenle" icon="sap-icon://edit" press=".onEditOrganizer"/>
              </HBox>
            </VBox>
          </Panel>
        </VBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
