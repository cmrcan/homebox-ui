<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.f" xmlns:card="sap.f.cards" controllerName="homebox.controller.Overview" height="100%">
  <Page showHeader="false" class="sapUiContentPadding">
    <content>
      <VBox width="100%">
        <core:Fragment fragmentName="homebox.fragment.Breadcrumbs" type="XML"/>
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML" class="sapUiSmallMarginBottom"/>
        <Text text="{/groupName}" class="sapUiSmallMarginBottom"/>
        <FlexBox renderType="Bare" wrap="Wrap" justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
          <Title text="Evine bir bakış." level="H1" titleStyle="H2" wrapping="true" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
          <Button text="Ürün ekle" type="Emphasized" icon="sap-icon://add" press=".onAddItem" enabled="{= !${/saving} &amp;&amp; !${/busy} }" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
        </FlexBox>
        <Text text="Evine ve eşyalarına dair her şey, bir arada." class="sapUiSmallMarginBottom"/>
        <f:GridContainer id="demoGrid" class="sapUiSmallMarginBottom" width="100%" containerQuery="true">
          <f:layout>
            <f:GridContainerSettings columnSize="5rem" rowSize="5rem" gap="1rem"/>
          </f:layout>
          <GenericTile header="Toplam Ürün" subheader="" frameType="OneByOne">
            <layoutData>
              <f:GridContainerItemLayoutData columns="2" rows="2"/>
            </layoutData>
            <TileContent unit="Adet" footer="">
              <NumericContent value="{/stats/totalItems}" icon="sap-icon://product" withMargin="false"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Toplam Değer" subheader="" frameType="OneByOne">
            <layoutData>
              <f:GridContainerItemLayoutData columns="2" rows="2"/>
            </layoutData>
            <TileContent unit="Adet" footer="">
              <NumericContent value="{parts:['/stats/totalItemPrice','/currency'],formatter:'.formatter.money'}" icon="sap-icon://product" withMargin="false"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Toplam Konum" subheader="" frameType="OneByOne">
            <layoutData>
              <f:GridContainerItemLayoutData columns="2" rows="2"/>
            </layoutData>
            <TileContent unit="Adet" footer="">
              <NumericContent value="{/stats/totalLocations}" icon="sap-icon://product" withMargin="false"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Garantili Ürün" subheader="" frameType="OneByOne">
            <layoutData>
              <f:GridContainerItemLayoutData columns="2" rows="2"/>
            </layoutData>
            <TileContent unit="Adet" footer="">
              <NumericContent value="{/stats/totalWithWarranty}" icon="sap-icon://product" withMargin="false"/>
            </TileContent>
          </GenericTile>
        </f:GridContainer>
        <Title text="Envanterin" level="H2" titleStyle="H3" class="sapUiSmallMarginBottom"/>
        <core:Fragment fragmentName="homebox.fragment.Inventory" type="XML" class="sapUiSmallMarginBottom"/>
      </VBox>
    </content>
  </Page>
</mvc:View>
