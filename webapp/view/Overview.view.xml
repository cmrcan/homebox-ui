<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.f" xmlns:card="sap.f.cards" controllerName="homebox.controller.Overview" height="100%">
  <Page showHeader="false" class="sapUiContentPadding">
    <content>
      <VBox width="100%">
        <f:HeroBanner id="homeHero" width="100%" headerText="Evine bir bakış." overlineText="{/groupName}" columnsRatio="Equal" actionsPlacement="BottomStart" headerBlockPlacement="Bottom" class="sapUiSmallMarginBottom">
          <f:actions>
            <Button text="Ürün ekle" icon="sap-icon://add" type="Emphasized" press=".onAddItem" enabled="{= !${/saving} &amp;&amp; !${/busy} }"/>
            <Button text="Envanteri aç" icon="sap-icon://list" type="Transparent" press=".onInventory"/>
            <Button text="Konumlar" icon="sap-icon://home" type="Transparent" press=".onLocations"/>
          </f:actions>
          <f:endContent>
            <FlexBox id="demoGrid" width="100%" wrap="Wrap" justifyContent="End" alignItems="Start">
              <GenericTile header="Toplam Ürün" subheader="" frameType="OneByOne" class="sapUiTinyMarginBegin sapUiTinyMarginBottom">
                <TileContent unit="Adet" footer="">
                  <NumericContent value="{/stats/totalItems}" icon="sap-icon://product" withMargin="false"/>
                </TileContent>
              </GenericTile>
              <GenericTile header="Toplam Değer" subheader="" frameType="OneByOne" class="sapUiTinyMarginBegin sapUiTinyMarginBottom">
                <TileContent unit="{/currency}" footer="" tooltip="{parts:['/stats/totalItemPrice','/currency'],formatter:'.formatter.money'}">
                  <NumericContent value="{path:'/stats/totalItemPrice',formatter:'.formatter.compactNumber'}" icon="sap-icon://product" withMargin="false" formatterValue="true"/>
                </TileContent>
              </GenericTile>
              <GenericTile header="Toplam Konum" subheader="" frameType="OneByOne" class="sapUiTinyMarginBegin sapUiTinyMarginBottom">
                <TileContent unit="Adet" footer="">
                  <NumericContent value="{/stats/totalLocations}" icon="sap-icon://product" withMargin="false"/>
                </TileContent>
              </GenericTile>
              <GenericTile header="Garantili Ürün" subheader="" frameType="OneByOne" class="sapUiTinyMarginBegin sapUiTinyMarginBottom">
                <TileContent unit="Adet" footer="">
                  <NumericContent value="{/stats/totalWithWarranty}" icon="sap-icon://product" withMargin="false"/>
                </TileContent>
              </GenericTile>
            </FlexBox>
          </f:endContent>
        </f:HeroBanner>
        <core:Fragment fragmentName="homebox.fragment.Breadcrumbs" type="XML"/>
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML" class="sapUiSmallMarginBottom"/>
        <Title text="Envanterin" level="H2" titleStyle="H3" class="sapUiSmallMarginBottom"/>
        <core:Fragment fragmentName="homebox.fragment.Inventory" type="XML" class="sapUiSmallMarginBottom"/>
      </VBox>
    </content>
  </Page>
</mvc:View>
