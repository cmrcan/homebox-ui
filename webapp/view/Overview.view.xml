<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="homebox.controller.Overview">
  <Page showHeader="false" class="hb-content-page">
    <content>
      <VBox width="100%" class="hb-page hb-stack">
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML"/>
        <Text text="{/groupName}" class="hb-muted"/>
        <FlexBox renderType="Bare" wrap="Wrap" justifyContent="SpaceBetween" alignItems="Center" class="hb-row">
          <Title text="Evine bir bakış." level="H1" titleStyle="H2" wrapping="true"/>
          <Button text="Ürün ekle" type="Emphasized" icon="sap-icon://add" press=".onAddItem" enabled="{= !${/saving} &amp;&amp; !${/busy} }"/>
        </FlexBox>
        <Text text="Evine ve eşyalarına dair her şey, bir arada."/>
        <FlexBox renderType="Bare" wrap="Wrap" class="hb-cards">
          <Panel headerText="Toplam ürün" class="hb-stat">
            <ObjectNumber number="{/stats/totalItems}"/>
          </Panel>
          <Panel headerText="Toplam değer" class="hb-stat">
            <ObjectNumber number="{parts:['/stats/totalItemPrice','/currency'],formatter:'.formatter.money'}"/>
          </Panel>
          <Panel headerText="Konumlar" class="hb-stat">
            <ObjectNumber number="{/stats/totalLocations}"/>
          </Panel>
          <Panel headerText="Garantili ürün" class="hb-stat">
            <ObjectNumber number="{/stats/totalWithWarranty}"/>
          </Panel>
        </FlexBox>
        <Title text="Envanterin" level="H2" titleStyle="H3"/>
        <core:Fragment fragmentName="homebox.fragment.Inventory" type="XML"/>
      </VBox>
    </content>
  </Page>
</mvc:View>
