<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="homebox.controller.Maintenance">
  <Page showHeader="false" class="hb-content-page">
    <content>
      <VBox width="100%" class="hb-page hb-stack">
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML"/>
        <Text text="{/groupName}" class="hb-muted"/>
        <FlexBox renderType="Bare" wrap="Wrap" justifyContent="SpaceBetween" alignItems="Center" class="hb-row">
          <Title text="Bakım" level="H1" titleStyle="H2" wrapping="true"/>
        </FlexBox>
        <VBox class="hb-field">
          <Label text="Bakım durumu" labelFor="maintenanceStatus"/>
          <Select id="maintenanceStatus" selectedKey="{view&gt;/status}" change=".onStatusChange">
            <core:Item key="scheduled" text="Planlanan"/>
            <core:Item key="completed" text="Tamamlanan"/>
            <core:Item key="both" text="Tümü"/>
          </Select>
        </VBox>
        <VBox items="{view&gt;/maintenance}" class="hb-stack">
          <Panel headerText="{view&gt;name}">
            <VBox class="hb-stack">
              <Text text="{view&gt;description}"/>
              <Text text="{path:'view&gt;scheduledDate',formatter:'.formatter.date'}"/>
              <Text text="{path:'view&gt;completedDate',formatter:'.formatter.date'}"/>
              <ObjectNumber number="{parts:['view&gt;cost','/currency'],formatter:'.formatter.money'}"/>
              <HBox class="hb-row">
                <Button text="Tamamlandı" icon="sap-icon://accept" press=".onCompleteMaintenance" visible="{= !${view&gt;completedDate} || ${view&gt;completedDate}.indexOf('0001') === 0 }"/>
                <Button text="Sil" icon="sap-icon://delete" press=".onDeleteMaintenance"/>
              </HBox>
            </VBox>
          </Panel>
        </VBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
