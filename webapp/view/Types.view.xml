<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="homebox.controller.Types" height="100%">
  <Page showHeader="false" class="sapUiContentPadding">
    <content>
      <VBox width="100%">
        <core:Fragment fragmentName="homebox.fragment.Breadcrumbs" type="XML"/>
        <core:Fragment fragmentName="homebox.fragment.Error" type="XML" class="sapUiSmallMarginBottom"/>
        <Text text="{/groupName}" class="sapUiSmallMarginBottom"/>
        <FlexBox renderType="Bare" wrap="Wrap" justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
          <Title text="Ürün türleri" level="H1" titleStyle="H2" wrapping="true" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
          <Button text="Tür ekle" type="Emphasized" icon="sap-icon://add" press=".onNew" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
        </FlexBox>
        <MessageStrip text="Ürün türleri için Homebox entities API gereklidir." visible="{= ${/mode} !== 'entities' }" class="sapUiSmallMarginBottom"/>
        <Table id="typesTable" items="{view&gt;/types}" autoPopinMode="true" contextualWidth="Auto" fixedLayout="true" growing="true" noDataText="Henüz ürün türü yok.">
          <columns>
            <Column width="12rem" importance="High">
              <Text text="Ad"/>
            </Column>
            <Column width="8rem" importance="High">
              <Text text="Kapsam"/>
            </Column>
            <Column width="16rem" importance="Low">
              <Text text="Açıklama"/>
            </Column>
            <Column width="13rem" importance="Medium">
              <Text text="Varsayılan alan şablonu"/>
            </Column>
            <Column width="11rem" importance="High">
              <Text text="İşlemler"/>
            </Column>
          </columns>
          <items>
            <ColumnListItem vAlign="Middle" type="Navigation" press=".onEdit">
              <cells>
                <ObjectIdentifier title="{view&gt;name}"/>
                <ObjectStatus text="{= ${view&gt;isLocation} ? 'Konum türü' : 'Ürün türü' }"/>
                <Text text="{view&gt;description}"/>
                <Select width="100%" tooltip="Varsayılan alan şablonu" selectedKey="{view&gt;templateId}" items="{view&gt;/templates}" change=".onTemplateChange">
                  <core:Item key="{view&gt;id}" text="{view&gt;name}"/>
                </Select>
                <HBox wrap="Wrap">
                  <Button text="Düzenle" icon="sap-icon://edit" press=".onEdit" class="sapUiTinyMarginEnd"/>
                  <Button text="Sil" icon="sap-icon://delete" press=".onDelete"/>
                </HBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
