{
  "name": "homebox-ui",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && ui5 build --all --clean-dest --include-task generateVersionInfo --dest dist",
    "preview": "node scripts/preview.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {},
  "devDependencies": {
    "@openui5/types": "1.154.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "@ui5/cli": "^4.0.73",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "ui5-tooling-transpile": "^3.0.0",
    "ui5-middleware-simpleproxy": "^3.0.0"
  }
}
