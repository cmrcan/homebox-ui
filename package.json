{
  "name": "homebox-ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/ui5-resources.mjs"
  },
  "dependencies": {
    "@vue/reactivity": "^3.5.20"
  },
  "devDependencies": {
    "@openui5/types": "1.154.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "@ui5/cli": "^4.0.73",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
