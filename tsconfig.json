{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@openui5/types", "node"],
    "noEmit": true,
    "useDefineForClassFields": false
  },
  "include": ["webapp/**/*.ts"]
}
